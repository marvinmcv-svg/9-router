# ─── Required ────────────────────────────────────────────────────────────────
# The kernel runs on claude-opus-5. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# ─── Google Workspace (Gmail, Calendar, Drive) ───────────────────────────────
# Create an OAuth 2.0 Web application client at console.cloud.google.com and
# enable the Gmail, Calendar and Drive APIs. Add this authorized redirect URI:
#   http://localhost:3000/api/auth/google       (development)
#   https://<your-domain>/api/auth/google       (production)
# Then click Connect in the Connectors panel to grant access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Development infrastructure ──────────────────────────────────────────────
# Fine-grained PAT: github.com/settings/tokens
GITHUB_TOKEN=
# vercel.com/account/tokens
VERCEL_TOKEN=
# railway.app/account/tokens
RAILWAY_TOKEN=

# ─── State ───────────────────────────────────────────────────────────────────
# Optional locally (state falls back to ./.jarvis), REQUIRED on serverless
# hosts, where the filesystem is ephemeral and not shared between invocations.
# Run supabase/schema.sql against the project first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Deployment ──────────────────────────────────────────────────────────────
# Public origin, used to build the Google OAuth redirect URI.
JARVIS_BASE_URL=http://localhost:3000
# IANA timezone used by scheduled routines.
JARVIS_TIMEZONE=UTC
# Shared secret the scheduler sends as `Authorization: Bearer <secret>`.
# Routines refuse to run in production without this.
JARVIS_CRON_SECRET=
